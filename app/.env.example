# API安全密钥（可选；设置后除登录接口外还需携带 X-API-Key）
# Web会话认证由下方 AUTH_* 配置控制
API_KEY=

# Web登录会话（建议部署时设置固定随机值，服务重启后登录态不会失效）
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=请修改为强密码
AUTH_SECRET=请修改为随机长字符串
AUTH_SESSION_TTL=28800

# DeepSeek API（主模型）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VERIFY_SSL=true

# MiMo API（备用模型）
MIMO_API_KEY=sk-your-mimo-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_VERIFY_SSL=true

# Embedding模型 (默认使用本地模型, 如需API可配置)
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER= dashscope
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# RPA服务地址
RPA_BASE_URL=http://localhost:8090

# 向量数据库路径
CHROMA_DB_PATH=./chroma_db

# 文本生成优先 DeepSeek，MiMo 自动备用
